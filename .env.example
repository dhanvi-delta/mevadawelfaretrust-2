# Public site URL — used for canonical URLs, sitemap, Open Graph and JSON-LD
NEXT_PUBLIC_SITE_URL=https://mevadawelfaretrust.com

# Contact form delivery (SMTP). Leave empty to disable delivery:
# the form will then offer visitors a pre-filled "Send via e-mail app" fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional overrides (defaults: info@mevadawelfaretrust.com / SMTP_USER)
CONTACT_TO=
CONTACT_FROM=
